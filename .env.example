NUXT_SESSION_PASSWORD=<password-with-at-least-32-characters>
NUXT_PUBLIC_GH_DEFAULT_BRANCH=<main>

# Scopes (repo, delete_repo) are requested in server/routes/auth/github.get.ts; after a scope change users must sign out and back in.
NUXT_OAUTH_GITHUB_CLIENT_ID=<generated-client-id>
NUXT_OAUTH_GITHUB_CLIENT_SECRET=<generated-client-secret>
# Absolute site URL for canonical/og tags. Defaults to Netlify's build-time URL.
NUXT_PUBLIC_SITE_URL=<https://your-site.example>
